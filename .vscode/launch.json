  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug current file",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--import", "tsx"],
      "program": "${file}",
      "skipFiles": ["<node_internals>/**"],
      "env": {
        "NODE_PATH": "${workspaceFolder}/node_modules"
      }
    }
    // {
    //   "type": "node",
    //   "request": "launch",
